# NXGEN Premier League — environment variables
# Copy to .env locally, and set ALL of these in Vercel (Project → Settings → Environment
# Variables) when moving off Lovable. Values come from Supabase → Project Settings → API.
# No real secrets in this file — names + notes only.

# --- Client (browser, Vite build-time; must start with VITE_) ---
VITE_SUPABASE_URL=            # https://vkmhgsprezswfkjdsiir.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=  # Supabase publishable/anon key
VITE_SUPABASE_PROJECT_ID=       # vkmhgsprezswfkjdsiir
VITE_SITE_URL=                  # https://nxgen.faehq.com  (public origin; feeds canonical/OG/sitemap)

# --- Server (SSR + OTP server functions) ---
SUPABASE_URL=                   # same as VITE_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=       # same as VITE_SUPABASE_PUBLISHABLE_KEY (used to send/verify email OTP)
SUPABASE_SERVICE_ROLE_KEY=      # REQUIRED for OTP — Supabase service_role key. NOT provided by
                                # default; Lovable injected it. MUST be added on Vercel or OTP breaks.
SUPABASE_PROJECT_ID=            # vkmhgsprezswfkjdsiir

# --- Optional / Lovable-only (safe to drop once off Lovable) ---
# LOVABLE_API_KEY=              # only used by Lovable AI features; not needed on Vercel
